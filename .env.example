# Database Connection String (PostgreSQL)
# For local PostgreSQL: postgresql://postgres:YOUR_PASSWORD@localhost:5432/universal_computers
# For Supabase / Cloud Postgres: postgresql://postgres.xxx:xxx@xxx.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/universal_computers"

# JWT Secret Key for Admin Authentication
JWT_SECRET="uc-super-secret-jwt-key-2024"

# Server Port (defaults to 3001)
PORT=3001

# Frontend URL for CORS
FRONTEND_URL="http://localhost:3000"

# Optional Email Configuration for Password Reset OTP (Gmail App Password)
# If left empty, OTP is logged to the server terminal console
EMAIL_USER=""
EMAIL_PASS=""
